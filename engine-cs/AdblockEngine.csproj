<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AdblockEngine</RootNamespace>
    <AssemblyName>adblock-engine-cs</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\vendor\windivert\WinDivert.dll" Link="WinDivert.dll" Condition="Exists('..\vendor\windivert\WinDivert.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\vendor\windivert\WinDivert64.sys" Link="WinDivert64.sys" Condition="Exists('..\vendor\windivert\WinDivert64.sys')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="WinDivert.dll" Condition="!Exists('..\vendor\windivert\WinDivert.dll') and Exists('WinDivert.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="WinDivert64.sys" Condition="!Exists('..\vendor\windivert\WinDivert64.sys') and Exists('WinDivert64.sys')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
