<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AdblockApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <PropertyGroup>
    <RustEngineManifest>$(MSBuildProjectDirectory)\..\engine-rs\Cargo.toml</RustEngineManifest>
    <RustEngineTargetDir>$(MSBuildProjectDirectory)\..\engine-rs\target\standalone</RustEngineTargetDir>
    <RustEngineReleaseDir>$(RustEngineTargetDir)\release</RustEngineReleaseDir>
  </PropertyGroup>

  <Target Name="BuildRustEngine" BeforeTargets="PrepareForBuild">
    <Exec Command="cargo build --release --manifest-path &quot;$(RustEngineManifest)&quot; --target-dir &quot;$(RustEngineTargetDir)&quot;" />
  </Target>

  <Target Name="CopyRustEngine" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)spec\test-data" />
    <Copy
      SourceFiles="$(RustEngineReleaseDir)\adblock-engine-rs.exe;$(RustEngineReleaseDir)\WinDivert.dll;$(RustEngineReleaseDir)\WinDivert64.sys"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\spec\test-data\rules.txt"
      DestinationFolder="$(OutDir)spec\test-data"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
